<?xml version="1.0"?>
<!-- NASA's Global Hawk N872NA (an RQ-4A) for FlightGear: a JSBSim model built from public data, with its own flight
     laws on board. Not made or endorsed by NASA or by the aircraft's makers. The real aircraft has no cockpit, and
     neither has this one: it is watched from outside or through a camera in the nose, and flown from the ground
     control station in gcs/ (start FlightGear with its web server on: the httpd option, port 5400). -->
<PropertyList>
 <sim>
  <description>Global Hawk, NASA 872 (JSBSim)</description>
  <long-description>NASA's high-altitude, long-endurance research aircraft, an RQ-4A, modelled from public data: not made or endorsed by NASA or the manufacturer. It flies itself: its flight laws are on board, and it is supervised from a ground control station in a browser (the gcs folder; start FlightGear with --httpd=5400). There is no cockpit, as on the real one.</long-description>
  <author>JSBSim model, flight laws and ground station from public data</author>
  <aircraft-version>0.1</aircraft-version>
  <status>alpha</status>
  <minimum-fg-version>2020.3.0</minimum-fg-version>
  <flight-model>jsb</flight-model>
  <aero>GlobalHawk</aero>
  <model><path>Aircraft/GlobalHawk/Models/GlobalHawk.xml</path></model>
  <rating><FDM type="int">3</FDM><systems type="int">2</systems><cockpit type="int">0</cockpit><model type="int">1</model></rating>
  <tags><tag>uav</tag><tag>jet</tag><tag>high-altitude</tag><tag>nasa</tag></tags>
  <!-- the camera in the nose: there is no cockpit to sit in -->
  <view n="0">
   <name>Nose Camera</name>
   <internal archive="y">false</internal>
   <config>
    <x-offset-m archive="y">0.0</x-offset-m>
    <y-offset-m archive="y">1.25</y-offset-m>
    <z-offset-m archive="y">0.35</z-offset-m>
    <pitch-offset-deg>-4</pitch-offset-deg>
    <default-field-of-view-deg type="double">70</default-field-of-view-deg>
   </config>
  </view>
  <chase-distance-m type="double" archive="y">-55</chase-distance-m>
  <help><title>Global Hawk</title><line>It flies itself. Supervise it from the ground control station: open gcs/index.html</line><line>and point it at FlightGear (started with --httpd=5400). With a joystick it is flown through its protected law.</line></help>
 </sim>
 <controls>
  <gear><brake-parking type="double">1</brake-parking><gear-down type="bool">true</gear-down></gear>
  <engines><engine n="0"><throttle type="double">0</throttle></engine></engines>
 </controls>
 <nasal><globalhawk>
  <file>Aircraft/GlobalHawk/Nasal/globalhawk.nas</file>
  <file>Aircraft/GlobalHawk/Nasal/json.nas</file>
  <file>Aircraft/GlobalHawk/Nasal/missionmgr.nas</file>
  <file>Aircraft/GlobalHawk/Nasal/onboard.nas</file>
 </globalhawk></nasal>
</PropertyList>
