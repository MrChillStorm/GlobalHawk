<?xml version="1.0"?>
<!-- Generated by fdm/genghawk.py. The direct commands (ctl/manual-*): what the surfaces follow when the flight laws
     (Systems/laws.xml) are off. Spoilers, gear and steering are direct for now. -->
<system name="controls">
  <property value="0">ctl/instant</property>
  <property value="0">fcs/throttle-cmd-norm</property>   <!-- the model has no JSBSim engine, so nothing else makes this one -->
  <property value="-0.5306">cal/spoiler-lift</property>
  <property value="0.03941">cal/spoiler-drag</property>
  <channel name="surfaces">
    <fcs_function name="ctl/manual-pitch-deg">
      <description>both ruddervators, trailing edge down positive: nose down</description>
      <function><product><value>20</value><property>fcs/elevator-cmd-norm</property></product></function>
      <clipto><min>-20</min><max>20</max></clipto>
    </fcs_function>
    <fcs_function name="ctl/manual-roll-deg">
      <description>roll command, right wing down positive</description>
      <function><product><value>20</value><property>fcs/aileron-cmd-norm</property></product></function>
      <clipto><min>-20</min><max>20</max></clipto>
    </fcs_function>
    <fcs_function name="ctl/manual-yaw-deg">
      <description>ruddervators against each other, nose right positive</description>
      <function><product><value>20</value><property>fcs/rudder-cmd-norm</property></product></function>
      <clipto><min>-20</min><max>20</max></clipto>
    </fcs_function>
    <fcs_function name="ctl/manual-spoiler-norm">
      <description>spoilers, 0 to 1 (1 is 45 deg), from the speedbrake command; the approach is taken to be flown at 30 deg</description>
      <function><property>fcs/speedbrake-cmd-norm</property></function>
      <clipto><min>0</min><max>1</max></clipto>
    </fcs_function>
    <fcs_function name="aero/wheel-height-ft">
      <description>height of the wheels above the ground, for ground effect</description>
      <function><difference><property>position/h-agl-ft</property><value>5.30</value></difference></function>
      <clipto><min>0</min><max>1000</max></clipto>
    </fcs_function>
    <kinematic name="gear/position">
      <description>gear travel: 8 s (an estimate)</description>
      <input>gear/gear-cmd-norm</input>
      <traverse><setting><position>0</position><time>0</time></setting><setting><position>1</position><time>8</time></setting></traverse>
      <output>gear/gear-pos-norm</output>
    </kinematic>
    <switch name="ctl/gear-norm">
      <description>gear position as the drag sees it: the command itself when ctl/instant is set (trims)</description>
      <default value="gear/gear-pos-norm"/>
      <test value="gear/gear-cmd-norm">ctl/instant == 1</test>
    </switch>
    <fcs_function name="ctl/steer-deg">
      <description>nose-wheel steering, 60 deg at full command</description>
      <function><product><value>60</value><property>fcs/steer-cmd-norm</property></product></function>
      <output>fcs/steer-pos-deg</output>
    </fcs_function>
  </channel>
</system>
