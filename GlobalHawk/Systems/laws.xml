<?xml version="1.0"?>
<!-- Generated by fdm/genghawk.py (fdm/laws.py). The flight laws: our own design, the real ones are not public.
     ap/engaged = 0 leaves the surfaces on the direct commands. -->
<system name="laws">
  <property value="0">ap/engaged</property>
  <property value="0">ap/pitch-mode</property>
  <property value="0">ap/roll-mode</property>
  <property value="0">ap/thrust-mode</property>
  <property value="0">ap/theta-cmd-deg</property>
  <property value="150">ap/speed-cmd-kcas</property>
  <property value="1">ap/speed-schedule</property>
  <property value="0">ap/speed-offset-kcas</property>
  <property value="0">ap/alt-cmd-ft</property>
  <property value="0">ap/bank-cmd-deg</property>
  <property value="0">ap/heading-cmd-deg</property>
  <property value="0.5">ap/throttle-cmd</property>
  <property value="1">ap/gain-scale</property>
  <property value="0">ap/bias-pitch-deg</property>
  <property value="0">ap/bias-yaw-deg</property>
  <property value="0">ap/bias-throttle</property>
  <property value="0">ap/theta-latched-deg</property>
  <property value="0">ap/theta-delta-deg</property>
  <channel name="flight laws">
    <fcs_function name="ap/gain-q">
      <description>gain schedule: control power goes with dynamic pressure</description>
      <function>
        <quotient><value>50</value><max><property>aero/qbar-psf</property><value>1</value></max></quotient>
      </function>
      <clipto><min>0.4</min><max>2.5</max></clipto>
    </fcs_function>
    <fcs_function name="ap/k-theta">
      <function>
        <product><value>1.4</value><property>ap/gain-q</property><property>ap/gain-scale</property></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/k-q">
      <function>
        <product><value>0.6</value><property>ap/gain-q</property><property>ap/gain-scale</property></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/k-theta-i">
      <function>
        <product><value>0.4</value><property>ap/gain-q</property><property>ap/gain-scale</property></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/k-phi">
      <function>
        <product><value>0.5</value><property>ap/gain-q</property><property>ap/gain-scale</property></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/k-phi-i">
      <function>
        <product><value>0</value><property>ap/gain-q</property><property>ap/gain-scale</property></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/k-p">
      <function>
        <product><value>0.6</value><property>ap/gain-q</property><property>ap/gain-scale</property></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/k-r">
      <function>
        <product><value>0.5</value><property>ap/gain-q</property><property>ap/gain-scale</property></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/k-beta">
      <function>
        <product><value>1.5</value><property>ap/gain-q</property><property>ap/gain-scale</property></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/k-beta-i">
      <function>
        <product><value>0.15</value><property>ap/gain-q</property><property>ap/gain-scale</property></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/schedule-mach">
      <description>the scheduled Mach number above FL220</description>
      <function>
          <table><independentVar lookup="row">engine/pressure-altitude-ft</independentVar><tableData>
              0 0
              22000 0.345
              55000 0.6
              80000 0.6
          </tableData></table>
      </function>
    </fcs_function>
    <fcs_function name="ap/schedule-kcas">
      <description>the scheduled speed as calibrated airspeed at this height: 150 KCAS low down, the scheduled Mach above</description>
      <function>
        <ifthen>
          <lt><property>engine/pressure-altitude-ft</property><value>22000</value></lt>
          <value>150</value>
          <product><property>velocities/vc-kts</property><quotient><property>ap/schedule-mach</property><max><property>velocities/mach</property><value>0.05</value></max></quotient></product>
        </ifthen>
      </function>
    </fcs_function>
    <fcs_function name="ap/schedule-less-offset">
      <function>
        <difference><property>ap/schedule-kcas</property><property>ap/speed-offset-kcas</property></difference>
      </function>
    </fcs_function>
    <switch name="ap/speed-target-kcas">
      <description>the commanded speed: the schedule less the operator's offset, or a commanded speed</description>
      <default value="ap/speed-cmd-kcas"/>
      <test value="ap/schedule-less-offset">ap/speed-schedule == 1</test>
    </switch>
    <fcs_function name="ap/alpha-limit-deg">
      <description>angle-of-attack limit: the lift break less a margin</description>
      <function>
          <table><independentVar lookup="row">velocities/mach</independentVar><tableData>
              0 7
              0.3 6
              0.5 5
              0.6 3.5
              0.65 2.5
          </tableData></table>
      </function>
    </fcs_function>
    <fcs_function name="ap/bank-limit-deg">
      <description>bank limit</description>
      <function>
          <table><independentVar lookup="row">engine/pressure-altitude-ft</independentVar><tableData>
              0 25
              30000 25
              50000 15
              80000 15
          </tableData></table>
      </function>
    </fcs_function>
    <switch name="ap/latch-bias-pitch-deg">
      <description>ruddervator angle at engagement</description>
      <default value="ap/bias-pitch-deg"/>
      <test value="ctl/manual-pitch-deg">ap/engaged == 0</test>
      <output>ap/bias-pitch-deg</output>
    </switch>
    <switch name="ap/latch-bias-yaw-deg">
      <description>yaw command at engagement</description>
      <default value="ap/bias-yaw-deg"/>
      <test value="ctl/manual-yaw-deg">ap/engaged == 0</test>
      <output>ap/bias-yaw-deg</output>
    </switch>
    <switch name="ap/latch-bias-throttle">
      <description>throttle at engagement</description>
      <default value="ap/bias-throttle"/>
      <test value="fcs/throttle-cmd-norm">ap/engaged == 0</test>
      <output>ap/bias-throttle</output>
    </switch>
    <switch name="ap/latch-theta-latched-deg">
      <description>pitch attitude at engagement</description>
      <default value="ap/theta-latched-deg"/>
      <test value="attitude/theta-deg">ap/engaged == 0</test>
      <output>ap/theta-latched-deg</output>
    </switch>
    <fcs_function name="ap/speed-error-kt">
      <description>fast is positive</description>
      <function>
        <difference><property>velocities/vc-kts</property><property>ap/speed-target-kcas</property></difference>
      </function>
    </fcs_function>
    <switch name="ap/trig-speed">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
        ap/pitch-mode == 1
      </test>
    </switch>
    <pid name="ap/theta-speed-deg">
      <input>ap/speed-error-kt</input>
      <kp>0.5</kp>
      <ki>0.03</ki>
      <kd>0</kd>
      <trigger>ap/trig-speed</trigger>
      <clipto><min>-20</min><max>20</max></clipto>
    </pid>
    <fcs_function name="ap/alt-error-ft">
      <function>
        <difference><property>ap/alt-cmd-ft</property><property>position/h-sl-ft</property></difference>
      </function>
      <clipto><min>-1500</min><max>1500</max></clipto>
    </fcs_function>
    <switch name="ap/trig-alt">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
        ap/pitch-mode == 2
      </test>
    </switch>
    <pid name="ap/theta-alt-pi-deg">
      <input>ap/alt-error-ft</input>
      <kp>0.012</kp>
      <ki>0.0012</ki>
      <kd>0</kd>
      <trigger>ap/trig-alt</trigger>
      <clipto><min>-12</min><max>12</max></clipto>
    </pid>
    <fcs_function name="ap/theta-alt-deg">
      <function>
        <difference><property>ap/theta-alt-pi-deg</property><product><value>0.06</value><property>velocities/h-dot-fps</property></product></difference>
      </function>
    </fcs_function>
    <fcs_function name="ap/theta-cmd-less-latched">
      <function>
        <difference><property>ap/theta-cmd-deg</property><property>ap/theta-latched-deg</property></difference>
      </function>
    </fcs_function>
    <switch name="ap/theta-mode-deg">
      <description>pitch attitude asked for by the mode, from the attitude latched at engagement</description>
      <default value="ap/theta-cmd-less-latched"/>
      <test value="ap/theta-speed-deg">ap/pitch-mode == 1</test>
      <test value="ap/theta-alt-deg">ap/pitch-mode == 2</test>
    </switch>
    <fcs_function name="ap/alpha-margin-deg">
      <description>room under the angle-of-attack limit</description>
      <function>
        <difference><property>ap/alpha-limit-deg</property><property>aero/alpha-deg</property></difference>
      </function>
    </fcs_function>
    <fcs_function name="ap/speed-margin-kt">
      <description>room above the lowest speed allowed: 15 kt under the commanded speed</description>
      <function>
        <difference><property>velocities/vc-kts</property><difference><property>ap/speed-target-kcas</property><value>15</value></difference></difference>
      </function>
    </fcs_function>
    <fcs_function name="ap/protect-fast-deg">
      <description>nose up above Mach 0.63</description>
      <function>
        <product><value>200</value><max><value>0</value><difference><property>velocities/mach</property><value>0.63</value></difference></max></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/theta-rate-deg_sec">
      <description>how fast the pitch command moves: towards the mode's, or down for angle of attack or speed, whichever is lowest</description>
      <function>
        <max>
          <value>-6</value>
          <min>
            <min><value>2</value><max><value>-2</value><product><value>2</value><difference><sum><property>ap/theta-mode-deg</property><property>ap/protect-fast-deg</property></sum><property>ap/theta-delta-deg</property></difference></product></max></min>
            <product><value>3</value><property>ap/alpha-margin-deg</property></product>
            <product><value>0.4</value><property>ap/speed-margin-kt</property></product>
          </min>
        </max>
      </function>
    </fcs_function>
    <switch name="ap/trig-governor">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
      </test>
    </switch>
    <pid name="ap/theta-governor">
      <description>the pitch command, as a change from the attitude latched at engagement</description>
      <input>ap/theta-rate-deg_sec</input>
      <kp>0</kp><ki>1</ki><kd>0</kd>
      <trigger>ap/trig-governor</trigger>
      <clipto><min>-16</min><max>18</max></clipto>
      <output>ap/theta-delta-deg</output>
    </pid>
    <fcs_function name="ap/protect-alpha-deg">
      <description>a direct push down in proportion to the angle of attack over its limit, ahead of the governor</description>
      <function>
        <product><value>2</value><min><value>0</value><property>ap/alpha-margin-deg</property></min></product>
      </function>
    </fcs_function>
    <fcs_function name="ap/theta-error-deg">
      <description>nose high is positive</description>
      <function>
        <difference><property>attitude/theta-deg</property><sum><property>ap/theta-latched-deg</property><property>ap/theta-delta-deg</property><property>ap/protect-alpha-deg</property></sum></difference>
      </function>
    </fcs_function>
    <switch name="ap/trig-pitch">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
      </test>
    </switch>
    <pid name="ap/pitch-pi-deg">
      <input>ap/theta-error-deg</input>
      <kp>ap/k-theta</kp>
      <ki>ap/k-theta-i</ki>
      <kd>0</kd>
      <trigger>ap/trig-pitch</trigger>
      <clipto><min>-25</min><max>25</max></clipto>
    </pid>
    <fcs_function name="ap/pitch-law-deg">
      <description>ruddervators together, trailing edge down positive</description>
      <function>
        <sum><property>ap/bias-pitch-deg</property><property>ap/pitch-pi-deg</property><product><property>ap/k-q</property><value>57.2958</value><property>velocities/q-rad_sec</property></product></sum>
      </function>
      <clipto><min>-20</min><max>20</max></clipto>
    </fcs_function>
    <fcs_function name="ap/heading-error-deg">
      <description>right of the nose is positive</description>
      <function>
        <difference>
          <mod><sum><difference><property>ap/heading-cmd-deg</property><property>attitude/psi-deg</property></difference><value>540</value></sum><value>360</value></mod>
          <value>180</value>
        </difference>
      </function>
    </fcs_function>
    <fcs_function name="ap/bank-heading-deg">
      <function>
        <product><value>1.2</value><property>ap/heading-error-deg</property><quotient><property>velocities/vt-fps</property><value>600</value></quotient></product>
      </function>
    </fcs_function>
    <switch name="ap/bank-mode-deg">
      <default value="ap/bank-cmd-deg"/>
      <test value="ap/bank-heading-deg">ap/roll-mode == 1</test>
    </switch>
    <fcs_function name="ap/bank-command-limit-deg">
      <description>the bank command stops 2 deg inside the limit: in a steady turn the bank settles above its command (a proportional law; an integral was tried and overshot)</description>
      <function>
        <difference><property>ap/bank-limit-deg</property><value>2</value></difference>
      </function>
    </fcs_function>
    <fcs_function name="ap/bank-clipped-deg">
      <description>inside the bank limit</description>
      <function>
        <max>
          <product><value>-1</value><property>ap/bank-command-limit-deg</property></product>
          <min><property>ap/bank-command-limit-deg</property><property>ap/bank-mode-deg</property></min>
        </max>
      </function>
    </fcs_function>
    <switch name="ap/bank-gated-deg">
      <default value="0"/>
      <test value="ap/bank-clipped-deg">ap/engaged == 1</test>
    </switch>
    <actuator name="ap/bank-target-deg">
      <description>the bank command moves at 5 deg/s at most</description>
      <input>ap/bank-gated-deg</input>
      <rate_limit>5</rate_limit>
    </actuator>
    <fcs_function name="ap/bank-error-deg">
      <function>
        <difference><property>ap/bank-target-deg</property><property>attitude/phi-deg</property></difference>
      </function>
    </fcs_function>
    <switch name="ap/trig-roll">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
        ap/bank-error-deg lt 3
        ap/bank-error-deg gt -3
      </test>
    </switch>
    <pid name="ap/roll-pi-deg">
      <input>ap/bank-error-deg</input>
      <kp>ap/k-phi</kp>
      <ki>ap/k-phi-i</ki>
      <kd>0</kd>
      <trigger>ap/trig-roll</trigger>
      <clipto><min>-20</min><max>20</max></clipto>
    </pid>
    <fcs_function name="ap/roll-law-deg">
      <description>roll command, right wing down positive</description>
      <function>
        <difference>
          <property>ap/roll-pi-deg</property>
          <product><property>ap/k-p</property><value>57.2958</value><property>velocities/p-rad_sec</property></product>
        </difference>
      </function>
      <clipto><min>-20</min><max>20</max></clipto>
    </fcs_function>
    <washout_filter name="ap/yaw-rate-washed">
      <input>velocities/r-rad_sec</input>
      <c1>0.3333</c1>
    </washout_filter>
    <switch name="ap/trig-beta">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
      </test>
    </switch>
    <pid name="ap/yaw-beta-deg">
      <input>aero/beta-deg</input>
      <kp>ap/k-beta</kp>
      <ki>ap/k-beta-i</ki>
      <kd>0</kd>
      <trigger>ap/trig-beta</trigger>
      <clipto><min>-12</min><max>12</max></clipto>
    </pid>
    <fcs_function name="ap/yaw-law-deg">
      <description>ruddervators against each other, nose right positive: damper, sideslip to zero (interconnect with the ailerons: gain 0 for now)</description>
      <function>
        <sum>
          <property>ap/bias-yaw-deg</property>
          <product><value>-1</value><property>ap/k-r</property><value>57.2958</value><property>ap/yaw-rate-washed</property></product>
          <property>ap/yaw-beta-deg</property>
          <product><value>-0</value><property>ap/roll-law-deg</property></product>
        </sum>
      </function>
      <clipto><min>-20</min><max>20</max></clipto>
    </fcs_function>
    <fcs_function name="ap/thrust-error-kt">
      <description>slow is positive</description>
      <function>
        <difference><property>ap/speed-target-kcas</property><property>velocities/vc-kts</property></difference>
      </function>
    </fcs_function>
    <switch name="ap/trig-thrust">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
        ap/thrust-mode == 3
      </test>
    </switch>
    <pid name="ap/thrust-pi">
      <input>ap/thrust-error-kt</input>
      <kp>0.04</kp>
      <ki>0.004</ki>
      <kd>0</kd>
      <trigger>ap/trig-thrust</trigger>
      <clipto><min>-1</min><max>1</max></clipto>
    </pid>
    <fcs_function name="ap/thrust-speed">
      <function>
        <sum><property>ap/bias-throttle</property><property>ap/thrust-pi</property></sum>
      </function>
      <clipto><min>0</min><max>1</max></clipto>
    </fcs_function>
    <switch name="ap/thrust-law">
      <default value="ap/throttle-cmd"/>
      <test value="1">ap/thrust-mode == 1</test>
      <test value="0">ap/thrust-mode == 2</test>
      <test value="ap/thrust-speed">ap/thrust-mode == 3</test>
    </switch>
    <switch name="ctl/throttle-norm">
      <description>what the engine takes: the laws' throttle when engaged, the throttle command otherwise</description>
      <default value="fcs/throttle-cmd-norm"/>
      <test value="ap/thrust-law">ap/engaged == 1</test>
    </switch>
    <switch name="ap/sel-pitch-deg">
      <default value="ctl/manual-pitch-deg"/>
      <test value="ap/pitch-law-deg">ap/engaged == 1</test>
    </switch>
    <actuator name="ap/act-pitch-deg">
      <input>ap/sel-pitch-deg</input>
      <lag>20</lag>
      <rate_limit>40</rate_limit>
      <clipto><min>-20</min><max>20</max></clipto>
    </actuator>
    <switch name="ctl/pitch-deg">
      <description>both ruddervators, trailing edge down positive: nose down</description>
      <default value="ap/act-pitch-deg"/>
      <test value="ap/sel-pitch-deg">ctl/instant == 1</test>
    </switch>
    <switch name="ap/sel-roll-cmd-deg">
      <default value="ctl/manual-roll-deg"/>
      <test value="ap/roll-law-deg">ap/engaged == 1</test>
    </switch>
    <actuator name="ap/act-roll-cmd-deg">
      <input>ap/sel-roll-cmd-deg</input>
      <lag>20</lag>
      <rate_limit>40</rate_limit>
      <clipto><min>-20</min><max>20</max></clipto>
    </actuator>
    <switch name="ctl/roll-cmd-deg">
      <description>roll command, right wing down positive</description>
      <default value="ap/act-roll-cmd-deg"/>
      <test value="ap/sel-roll-cmd-deg">ctl/instant == 1</test>
    </switch>
    <switch name="ap/sel-yaw-deg">
      <default value="ctl/manual-yaw-deg"/>
      <test value="ap/yaw-law-deg">ap/engaged == 1</test>
    </switch>
    <actuator name="ap/act-yaw-deg">
      <input>ap/sel-yaw-deg</input>
      <lag>20</lag>
      <rate_limit>40</rate_limit>
      <clipto><min>-20</min><max>20</max></clipto>
    </actuator>
    <switch name="ctl/yaw-deg">
      <description>ruddervators against each other, nose right positive</description>
      <default value="ap/act-yaw-deg"/>
      <test value="ap/sel-yaw-deg">ctl/instant == 1</test>
    </switch>
    <fcs_function name="ctl/aileron-deg">
      <description>ailerons as the aerodynamic tables take them: right trailing edge down positive, which rolls left</description>
      <function>
        <product><value>-1</value><property>ctl/roll-cmd-deg</property></product>
      </function>
    </fcs_function>
  </channel>
</system>
