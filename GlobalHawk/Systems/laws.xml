        ap/engaged == 1
        ap/bank-error-deg lt 3
        ap/bank-error-deg gt -3
      </test>
    </switch>
    <pid name="ap/roll-pi-deg">
      <input>ap/bank-error-deg</input>
      <kp>ap/k-phi</kp>
      <ki>ap/k-phi-i</ki>
      <kd>0</kd>
      <trigger>ap/trig-roll</trigger>
      <clipto><min>-20</min><max>20</max></clipto>
    </pid>
    <fcs_function name="ap/roll-law-deg">
      <description>roll command, right wing down positive</description>
      <function>
        <difference>
          <property>ap/roll-pi-deg</property>
          <product><property>ap/k-p</property><value>57.2958</value><property>velocities/p-rad_sec</property></product>
        </difference>
      </function>
      <clipto><min>-20</min><max>20</max></clipto>
    </fcs_function>
    <washout_filter name="ap/yaw-rate-washed">
      <input>velocities/r-rad_sec</input>
      <c1>0.3333</c1>
    </washout_filter>
    <switch name="ap/trig-beta">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
      </test>
    </switch>
    <fcs_function name="ap/beta-gated-deg">
      <description>sideslip, faded out below 60 kt: it means nothing at a walk</description>
      <function>
        <product><property>aero/beta-deg</property><max><value>0</value><min><value>1</value><quotient><difference><property>velocities/vc-kts</property><value>40</value></difference><value>20</value></quotient></min></max></product>
      </function>
    </fcs_function>
    <pid name="ap/yaw-beta-deg">
      <input>ap/beta-gated-deg</input>
      <kp>ap/k-beta</kp>
      <ki>ap/k-beta-i</ki>
      <kd>0</kd>
      <trigger>ap/trig-beta</trigger>
      <clipto><min>-12</min><max>12</max></clipto>
    </pid>
    <fcs_function name="ap/yaw-ground-deg">
      <description>on the ground the ruddervators help the nose wheel</description>
      <function>
        <product><property>ap/ground-steer</property><min><value>1</value><property>ap/on-mains</property></min><value>0.5</value><property>ap/ground-error-deg</property></product>
      </function>
      <clipto><min>-10</min><max>10</max></clipto>
    </fcs_function>
    <fcs_function name="ap/yaw-law-deg">
      <description>ruddervators against each other, nose right positive: damper, sideslip to zero (interconnect with the ailerons: gain 0 for now)</description>
      <function>
        <sum>
          <property>ap/bias-yaw-deg</property>
          <product><value>-1</value><property>ap/k-r</property><value>57.2958</value><property>ap/yaw-rate-washed</property></product>
          <property>ap/yaw-beta-deg</property>
          <product><value>-0</value><property>ap/roll-law-deg</property></product>
          <property>ap/yaw-ground-deg</property>
        </sum>
      </function>
      <clipto><min>-20</min><max>20</max></clipto>
    </fcs_function>
    <fcs_function name="ap/thrust-error-kt">
      <description>slow is positive</description>
      <function>
        <difference><property>ap/speed-target-kcas</property><property>velocities/vc-kts</property></difference>
      </function>
    </fcs_function>
    <switch name="ap/trig-thrust">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
        ap/thrust-mode == 3
      </test>
    </switch>
    <pid name="ap/thrust-pi">
      <input>ap/thrust-error-kt</input>
      <kp>0.04</kp>
      <ki>0.004</ki>
      <kd>0</kd>
      <trigger>ap/trig-thrust</trigger>
      <clipto><min>-1</min><max>1</max></clipto>
    </pid>
    <fcs_function name="ap/thrust-speed">
      <function>
        <sum><property>ap/bias-throttle</property><property>ap/thrust-pi</property></sum>
      </function>
      <clipto><min>0</min><max>1</max></clipto>
    </fcs_function>
    <fcs_function name="ap/taxi-error-kt">
      <function>
        <difference><property>ap/taxi-speed-kt</property><property>ap/ground-speed-kt</property></difference>
      </function>
    </fcs_function>
    <switch name="ap/trig-taxi">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
        ap/thrust-mode == 4
        ap/taxi-speed-kt gt 0.5
      </test>
    </switch>
    <pid name="ap/taxi-throttle">
      <input>ap/taxi-error-kt</input>
      <kp>0.03</kp>
      <ki>0.003</ki>
      <kd>0</kd>
      <trigger>ap/trig-taxi</trigger>
      <clipto><min>0</min><max>0.4</max></clipto>
    </pid>
    <switch name="ap/thrust-law">
      <default value="ap/throttle-cmd"/>
      <test value="0">ap/land-mode == 1</test>
      <test value="ap/taxi-throttle">ap/thrust-mode == 4</test>
      <test value="1">ap/thrust-mode == 1</test>
      <test value="0">ap/thrust-mode == 2</test>
      <test value="ap/thrust-speed">ap/thrust-mode == 3</test>
    </switch>
    <switch name="ctl/throttle-norm">
      <description>what the engine takes: the laws' throttle when engaged, the throttle command otherwise</description>
      <default value="fcs/throttle-cmd-norm"/>
      <test value="ap/thrust-law">ap/engaged == 1</test>
    </switch>
    <fcs_function name="ap/glide-height-ft">
      <description>height of the glide path here: the leg ends at the aiming point</description>
      <function>
        <sum><property>ap/rwy-elev-ft</property><value>5.3</value><product><value>0.07782</value><max><value>0</value><property>ap/leg-togo-ft</property></max></product></sum>
      </function>
    </fcs_function>
    <fcs_function name="ap/glide-error-ft">
      <description>high is positive</description>
      <function>
        <difference><property>position/h-sl-ft</property><property>ap/glide-height-ft</property></difference>
      </function>
      <clipto><min>-300</min><max>300</max></clipto>
    </fcs_function>
    <fcs_function name="ap/glide-sink-error-fps">
      <description>sinking less than the path asks is positive</description>
      <function>
        <sum><property>velocities/h-dot-fps</property><product><value>0.07782</value><property>velocities/vg-fps</property></product></sum>
      </function>
    </fcs_function>
    <switch name="ap/trig-glide">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
        ap/land-mode == 1
        ap/flare == 0
        ap/rollout == 0
      </test>
    </switch>
    <pid name="ap/glide-i">
      <input>ap/glide-error-ft</input>
      <kp>0.0</kp>
      <ki>0.0004</ki>
      <kd>0</kd>
      <trigger>ap/trig-glide</trigger>
      <clipto><min>-0.25</min><max>0.25</max></clipto>
    </pid>
    <fcs_function name="ap/spoiler-glide">
      <description>spoilers hold the glide path: more when high or sinking too little</description>
      <function>
        <sum><value>0.667</value><product><value>0.004</value><property>ap/glide-error-ft</property></product><product><value>0.02</value><property>ap/glide-sink-error-fps</property></product><property>ap/glide-i</property></sum>
      </function>
      <clipto><min>0.10</min><max>1</max></clipto>
    </fcs_function>
    <switch name="ap/latch-spoiler-base">
      <description>the spoiler setting at the start of the flare</description>
      <default value="ap/spoiler-base"/>
      <test value="ap/spoiler-glide">ap/flare == 0</test>
      <output>ap/spoiler-base</output>
    </switch>
    <fcs_function name="ap/flare-sink-wanted-fps">
      <description>the sink wanted in the flare: the approach's, falling with height to 2.3 ft/s at the ground</description>
      <function>
        <max><value>2.3</value><product><value>0.07782</value><property>velocities/vg-fps</property><quotient><property>aero/wheel-height-ft</property><value>70</value></quotient></product></max>
      </function>
    </fcs_function>
    <fcs_function name="ap/spoiler-flare">
      <description>in the flare the spoilers work on sink rate alone: they come in as far as the sink needs</description>
      <function>
        <sum><property>ap/spoiler-base</property><product><value>0.25</value><sum><property>velocities/h-dot-fps</property><property>ap/flare-sink-wanted-fps</property></sum></product></sum>
      </function>
      <clipto><min>0.10</min><max>1</max></clipto>
    </fcs_function>
    <switch name="ap/spoiler-law">
      <default value="ctl/manual-spoiler-norm"/>
      <test value="1">ap/rollout == 1</test>
      <test value="ap/spoiler-flare">ap/flare == 1</test>
      <test value="ap/spoiler-glide">ap/land-mode == 1</test>
      <test value="ap/spoiler-cmd">ap/spoiler-mode == 1</test>
    </switch>
    <switch name="ap/sel-spoiler">
      <default value="ctl/manual-spoiler-norm"/>
      <test value="ap/spoiler-law">ap/engaged == 1</test>
    </switch>
    <actuator name="ap/act-spoiler">
      <input>ap/sel-spoiler</input>
      <lag>10</lag>
      <rate_limit>0.667</rate_limit>
      <clipto><min>0</min><max>1</max></clipto>
    </actuator>
    <switch name="ctl/spoiler-norm">
      <description>spoilers, 0 to 1 (1 is 45 deg)</description>
      <default value="ap/act-spoiler"/>
      <test value="ap/sel-spoiler">ctl/instant == 1</test>
    </switch>
    <fcs_function name="ap/decel-error-g">
      <description>wanted deceleration less the present one</description>
      <function>
        <sum><value>0.235</value><quotient><property>accelerations/udot-ft_sec2</property><value>32.174</value></quotient></sum>
      </function>
    </fcs_function>
    <switch name="ap/trig-decel">
      <default value="-1"/>
      <test logic="AND" value="0">
        ap/engaged == 1
        ap/rollout == 1
        gear/unit[0]/WOW == 1
        ap/ground-speed-kt gt 15
      </test>
    </switch>
    <pid name="ap/brake-decel">
      <input>ap/decel-error-g</input>
      <kp>0.0</kp>
      <ki>0.8</ki>
      <kd>0</kd>
      <trigger>ap/trig-decel</trigger>
      <clipto><min>0</min><max>1</max></clipto>
    </pid>
    <fcs_function name="ap/brake-taxi">
      <description>taxi: brakes when over the speed, held on when stopped</description>
      <function>
        <ifthen>
          <and><lt><property>ap/taxi-speed-kt</property><value>0.5</value></lt><lt><property>ap/ground-speed-kt</property><value>1.5</value></lt></and>
          <value>1</value>
          <product><value>0.6</value><difference><difference><property>ap/ground-speed-kt</property><property>ap/taxi-speed-kt</property></difference><value>0.2</value></difference></product>
        </ifthen>
      </function>
      <clipto><min>0</min><max>1</max></clipto>
    </fcs_function>
    <switch name="ap/brake-law">
      <default value="0"/>
      <test value="ap/brake-decel">ap/rollout == 1</test>
      <test value="ap/brake-taxi">ap/thrust-mode == 4</test>
    </switch>
    <fcs_function name="ap/brake-left">
      <function>
        <ifthen><eq><property>ap/engaged</property><value>1</value></eq><property>ap/brake-law</property><property>fcs/left-brake-cmd-norm</property></ifthen>
      </function>
      <output>fcs/left-brake-cmd-norm</output>
    </fcs_function>
    <fcs_function name="ap/brake-right">
      <function>
        <ifthen><eq><property>ap/engaged</property><value>1</value></eq><property>ap/brake-law</property><property>fcs/right-brake-cmd-norm</property></ifthen>
      </function>
      <output>fcs/right-brake-cmd-norm</output>
    </fcs_function>
    <fcs_function name="ap/steer-limit">
      <description>nose-wheel travel allowed, falling with speed</description>
      <function>
        <quotient><value>12</value><max><value>1</value><property>velocities/vg-fps</property></max></quotient>
      </function>
      <clipto><min>0.08</min><max>0.6</max></clipto>
    </fcs_function>
    <fcs_function name="ap/steer-law">
      <function>
        <max>
          <product><value>-1</value><property>ap/steer-limit</property></product>
          <min><property>ap/steer-limit</property><difference><product><value>0.02</value><property>ap/ground-error-deg</property></product><product><value>0.8</value><property>velocities/r-rad_sec</property></product></difference></min>
        </max>
      </function>
    </fcs_function>
    <fcs_function name="ap/steer-out-deg">
      <description>the nose wheel: the law's when steering on the ground, the direct command otherwise</description>
      <function>
        <product>
          <value>60</value>
          <ifthen><and><eq><property>ap/engaged</property><value>1</value></eq><eq><property>ap/ground-steer</property><value>1</value></eq></and><property>ap/steer-law</property><property>fcs/steer-cmd-norm</property></ifthen>
        </product>
      </function>
      <output>fcs/steer-pos-deg</output>
    </fcs_function>
    <switch name="ap/sel-pitch-deg">
      <default value="ctl/manual-pitch-deg"/>
      <test value="ap/pitch-out-deg">ap/engaged == 1</test>
    </switch>
    <actuator name="ap/act-pitch-deg">
      <input>ap/sel-pitch-deg</input>
      <lag>20</lag>
      <rate_limit>40</rate_limit>
      <clipto><min>-20</min><max>20</max></clipto>
    </actuator>
    <switch name="ctl/pitch-deg">
      <description>both ruddervators, trailing edge down positive: nose down</description>
      <default value="ap/act-pitch-deg"/>
      <test value="ap/sel-pitch-deg">ctl/instant == 1</test>
    </switch>
    <switch name="ap/sel-roll-cmd-deg">
      <default value="ctl/manual-roll-deg"/>
      <test value="ap/roll-law-deg">ap/engaged == 1</test>
    </switch>
    <actuator name="ap/act-roll-cmd-deg">
      <input>ap/sel-roll-cmd-deg</input>
      <lag>20</lag>
      <rate_limit>40</rate_limit>
      <clipto><min>-20</min><max>20</max></clipto>
    </actuator>
    <switch name="ctl/roll-cmd-deg">
      <description>roll command, right wing down positive</description>
      <default value="ap/act-roll-cmd-deg"/>
      <test value="ap/sel-roll-cmd-deg">ctl/instant == 1</test>
    </switch>
    <switch name="ap/sel-yaw-deg">
      <default value="ctl/manual-yaw-deg"/>
      <test value="ap/yaw-law-deg">ap/engaged == 1</test>
    </switch>
    <actuator name="ap/act-yaw-deg">
      <input>ap/sel-yaw-deg</input>
      <lag>20</lag>
      <rate_limit>40</rate_limit>
      <clipto><min>-20</min><max>20</max></clipto>
    </actuator>
    <switch name="ctl/yaw-deg">
      <description>ruddervators against each other, nose right positive</description>
      <default value="ap/act-yaw-deg"/>
      <test value="ap/sel-yaw-deg">ctl/instant == 1</test>
    </switch>
    <fcs_function name="ctl/aileron-deg">
      <description>ailerons as the aerodynamic tables take them: right trailing edge down positive, which rolls left</description>
      <function>
        <product><value>-1</value><property>ctl/roll-cmd-deg</property></product>
      </function>
    </fcs_function>
  </channel>
</system>
