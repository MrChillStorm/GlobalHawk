<?xml version="1.0"?>
<!-- Generated by fdm/genghawk.py. The real aircraft's fuel system isn't public: this layout and its management are ours.
     Every tank gives up fuel in proportion to its contents, so the fuel's centre stays where it is: at the
     centre-of-gravity target, by the tank sizes in fdm/data/mass.json. -->
<system name="fuel">
  <property value="0">fuel/freeze</property>
  <channel name="fuel management">
    <fcs_function name="fuel/total-lbs">
      <function>
        <sum>
          <property>propulsion/tank[0]/contents-lbs</property>
          <property>propulsion/tank[1]/contents-lbs</property>
          <property>propulsion/tank[2]/contents-lbs</property>
          <property>propulsion/tank[3]/contents-lbs</property>
          <property>propulsion/tank[4]/contents-lbs</property>
          <property>propulsion/tank[5]/contents-lbs</property>
        </sum>
      </function>
    </fcs_function>
    <fcs_function name="fuel/burn-lbs">
      <description>fuel used this frame</description>
      <function>
        <product>
          <difference><value>1</value><property>fuel/freeze</property></difference>
          <property>engine/fuel-flow-pph</property>
          <property>simulation/dt</property>
          <value>0.000277778</value>
        </product>
      </function>
    </fcs_function>
    <fcs_function name="fuel/tank-0-lbs">
      <description>wing inboard left: its share of this frame's fuel, in proportion to what it holds</description>
      <function>
        <max>
          <value>0</value>
          <difference>
            <property>propulsion/tank[0]/contents-lbs</property>
            <product>
              <property>fuel/burn-lbs</property>
              <quotient><property>propulsion/tank[0]/contents-lbs</property><max><property>fuel/total-lbs</property><value>0.001</value></max></quotient>
            </product>
          </difference>
        </max>
      </function>
      <output>propulsion/tank[0]/contents-lbs</output>
    </fcs_function>
    <fcs_function name="fuel/tank-1-lbs">
      <description>wing inboard right: its share of this frame's fuel, in proportion to what it holds</description>
      <function>
        <max>
          <value>0</value>
          <difference>
            <property>propulsion/tank[1]/contents-lbs</property>
            <product>
              <property>fuel/burn-lbs</property>
              <quotient><property>propulsion/tank[1]/contents-lbs</property><max><property>fuel/total-lbs</property><value>0.001</value></max></quotient>
            </product>
          </difference>
        </max>
      </function>
      <output>propulsion/tank[1]/contents-lbs</output>
    </fcs_function>
    <fcs_function name="fuel/tank-2-lbs">
      <description>wing outboard left: its share of this frame's fuel, in proportion to what it holds</description>
      <function>
        <max>
          <value>0</value>
          <difference>
            <property>propulsion/tank[2]/contents-lbs</property>
            <product>
              <property>fuel/burn-lbs</property>
              <quotient><property>propulsion/tank[2]/contents-lbs</property><max><property>fuel/total-lbs</property><value>0.001</value></max></quotient>
            </product>
          </difference>
        </max>
      </function>
      <output>propulsion/tank[2]/contents-lbs</output>
    </fcs_function>
    <fcs_function name="fuel/tank-3-lbs">
      <description>wing outboard right: its share of this frame's fuel, in proportion to what it holds</description>
      <function>
        <max>
          <value>0</value>
          <difference>
            <property>propulsion/tank[3]/contents-lbs</property>
            <product>
              <property>fuel/burn-lbs</property>
              <quotient><property>propulsion/tank[3]/contents-lbs</property><max><property>fuel/total-lbs</property><value>0.001</value></max></quotient>
            </product>
          </difference>
        </max>
      </function>
      <output>propulsion/tank[3]/contents-lbs</output>
    </fcs_function>
    <fcs_function name="fuel/tank-4-lbs">
      <description>fuselage forward: its share of this frame's fuel, in proportion to what it holds</description>
      <function>
        <max>
          <value>0</value>
          <difference>
            <property>propulsion/tank[4]/contents-lbs</property>
            <product>
              <property>fuel/burn-lbs</property>
              <quotient><property>propulsion/tank[4]/contents-lbs</property><max><property>fuel/total-lbs</property><value>0.001</value></max></quotient>
            </product>
          </difference>
        </max>
      </function>
      <output>propulsion/tank[4]/contents-lbs</output>
    </fcs_function>
    <fcs_function name="fuel/tank-5-lbs">
      <description>fuselage aft: its share of this frame's fuel, in proportion to what it holds</description>
      <function>
