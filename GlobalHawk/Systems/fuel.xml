        </max>
      </function>
      <output>propulsion/tank[5]/contents-lbs</output>
    </fcs_function>
    <switch name="fuel/engine-fed">
      <description>the engine stops when the tanks are dry</description>
      <default value="1"/>
      <test value="0">fuel/total-lbs lt 1</test>
      <output>engine/running</output>
    </switch>
  </channel>
</system>
